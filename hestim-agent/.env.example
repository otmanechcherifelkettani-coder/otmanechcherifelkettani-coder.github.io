# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
HESTIM_MODEL=claude-opus-5-5
# Opus 5.5 always reasons before answering; effort sets how much (low|medium|high).
# Cheaper/faster options: claude-sonnet-5-5, claude-haiku-5-5 (re-run simulate.py if you switch).
HESTIM_EFFORT=low
AGENT_NAME=Nora

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# --- Instagram Messaging (Meta Graph API, page-scoped) ---
INSTAGRAM_PAGE_TOKEN=
# Shared verify token you set in the Meta app webhook config
META_VERIFY_TOKEN=change-me
# App secret, used to check X-Hub-Signature-256 on incoming webhooks
META_APP_SECRET=

# --- Inbox ---
# One login per staff member: name:password:role, comma-separated. Their name signs their replies.
# role = admin (sees everything) or one or more teams joined by | :
#   admissions | finance | scolarite | vie_etudiante
# Staff only see conversations, contacts and escalations of their own teams.
INBOX_USERS=Direction:change-me-0:admin,Karim:change-me-1:admissions,Fatima:change-me-2:finance,Sara:change-me-3:scolarite|vie_etudiante
# Used only if INBOX_USERS is empty
INBOX_USER=admissions
INBOX_PASSWORD=change-me
DB_PATH=data/hestim.db

# --- Nurturing ---
# Hours of silence before an undecided lead gets a follow-up (WhatsApp 24h window applies)
FOLLOWUP_AFTER_HOURS=20
